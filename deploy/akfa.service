[Unit]
Description=Saramax AKFA Django Gunicorn Daemon
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/akfa
ExecStart=/var/www/akfa/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --timeout 90 \
          --access-logfile /var/log/gunicorn-akfa-access.log \
          --error-logfile /var/log/gunicorn-akfa-error.log \
          config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
